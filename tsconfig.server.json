{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "types": ["node"],
    "noUnusedLocals": true
  },
  "include": ["server/**/*.ts", "server/**/*.d.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "dist", "node_modules"]
}
