# DropCut environment. Copy to .env. Never commit .env. Never put a real key in the repo.
# Backend: mock | comfy-cloud
# When GENERATION_BACKEND is empty, DropCut uses comfy-cloud if COMFY_CLOUD_API_KEY is set, otherwise mock.
GENERATION_BACKEND=

# Account API key from https://platform.comfy.org/profile/api-keys
# Needs an active Comfy Cloud subscription with credits. The key never goes to the browser.
COMFY_CLOUD_API_KEY=
COMFY_CLOUD_BASE_URL=https://cloud.comfy.org
# v2 (preferred) or v1 (deprecated ComfyUI-compatible endpoints)
COMFY_CLOUD_API_VERSION=v2
# Optional: run on your own Comfy deployment (scale to zero). Set the base URL to its endpoint.
# COMFY_CLOUD_BASE_URL=https://<deployment-id>.run.comfy.app
COMFY_DEPLOYMENT_ID=
# Minutes after the last segment before the deployment is stopped (0 = never auto-stop).
DEPLOY_IDLE_STOP_MIN=10
# COMFY_DEPLOY_URL=https://platformapi.comfy.org/deploy
COMFY_WORKFLOW=workflows/ltx-i2v.api.json
COMFY_WORKFLOW_MAP=workflows/ltx-i2v.map.json

# How many segment jobs run at once.
MAX_CONCURRENT_SEGMENTS=2

# API port. In dev, Vite proxies /api to this port (8787). `npm start` serves the site and the API here.
PORT=8787

# Mock adapter only. 0 never fails. 1 always fails. Values in between fail deterministically from the segment cache key and attempt.
MOCK_FAIL_RATE=0
# Simulated queue+run delay for the mock adapter, in milliseconds.
MOCK_LATENCY_MS=400

# Final MP4. ffmpeg is resolved as FFMPEG_PATH, then ffmpeg on PATH, then ffmpeg-static.
# FFPROBE_PATH is optional. Empty EXPORT_END_CARD_URL means no end card.
# FFMPEG_PATH=
# FFPROBE_PATH=
EXPORT_FPS=30
EXPORT_END_CARD_URL=
EXPORT_END_CARD_SECONDS=2

# Dedicated deployment endpoint (recommended). Jobs go to this URL with Bearer auth.
# Setting it turns DEPLOY_CONTROL off automatically, so DropCut won't start or stop the deployment.
# COMFY_DEPLOYMENT_ENDPOINT=https://<deployment-id>.run.comfy.app
# DEPLOY_CONTROL=manage   # manage | off
